# Địa chỉ backend khi phát triển. Không đặt khóa bí mật của mô hình vào biến VITE_.
VITE_API_BASE_URL=http://localhost:8000/api

# true = giao diện demo, không gọi mô hình pháp luật.
VITE_USE_MOCK=false

# Thời gian chờ mỗi request, tính bằng mili giây.
VITE_API_TIMEOUT=90000

# cookie: phiên HttpOnly do backend đặt. bearer: frontend giữ access token.
VITE_AUTH_MODE=cookie

# true = bắt đăng nhập trước khi vào chat và cài đặt.
VITE_REQUIRE_AUTH=false

# local = lịch sử trên thiết bị. api = GET/POST/PATCH/DELETE /conversations.
VITE_HISTORY_MODE=local

# true = gửi cookie cả khi AUTH_MODE=bearer. Cookie mode luôn gửi cookie.
VITE_API_WITH_CREDENTIALS=false

# Để trống nếu backend không dùng CSRF tùy chỉnh.
# Axios vẫn tự gửi X-XSRF-TOKEN khi có cookie XSRF-TOKEN.
VITE_CSRF_COOKIE=
VITE_CSRF_HEADER=

# Mã khách OAuth của Google (public). Không điền client secret vào đây.
# Origin được phép phải có địa chỉ đang chạy, ví dụ http://localhost:5173
VITE_GOOGLE_CLIENT_ID=
